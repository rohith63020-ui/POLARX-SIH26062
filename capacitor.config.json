{
  "appId": "com.polarx.app",
  "appName": "POLARX",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#071828",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#071828"
    }
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true
  }
}
